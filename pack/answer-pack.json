          ],
          "summary": "TIGER 将物品编码为语义层级残差码元组，并用 Transformer sequence-to-sequence 模型按从粗到细前缀自回归逐位预测。"
        },
        {
          "id": "c1-parallel-independence",
          "record_id": "rpg",
          "direction": "Unordered OPQ sub-tokens -> parallel MTP factorization",
          "grade": "Reported",
          "evidence": [
            "rpg-independence"
          ],
          "summary": "RPG 采用 OPQ 将嵌入划分为多个无序子空间码位，并在单步解码中对全部码位的对数似然独立求和（MTP）。"
        },
        {
          "id": "c1-rq-counterexample",
          "record_id": "rpg",
          "direction": "Swapping OPQ -> RQ inside parallel MTP + graph decoding degrades accuracy",
          "grade": "Reported",
          "evidence": [
            "rpg-rq-ablation",
            "rpg-rq-setting"
          ],
          "summary": "RPG 3.4 节（#S3.SS4.p2.1）与 Table 3（#S3.T3）在保持 MTP 并行预测与图解码不变时将 OPQ 替换为 RQ，Beauty NDCG@10 从 0.0464 降至 0.0421。"
        },
        {
          "id": "c1-masked-coupling",
          "record_id": "llada-rec",
          "direction": "Inter-token dependency -> bidirectional parallel masked diffusion",
          "grade": "Reported",
          "evidence": [
            "llada-coupling"
          ],
          "summary": "LLaDA-Rec 指出固定自左向右自回归会限制多码位双向耦合建模，改用双向注意力掩码扩散迭代去噪生成完整 SID。"
        },
        {
          "id": "c1-sidmlp-prefix-ablation",
          "record_id": null,
          "external_paper": "SID-MLP (arXiv:2605.12617v1)",
          "direction": "Fixed RQ-VAE code + removing prefix conditioning in parallel heads -> severe degradation",
          "grade": "Reported",
          "evidence": [
            "sidmlp-noprefix"
          ],
          "summary": "SID-MLP 4.3 节（#S4.SS3.p2.1）在固定 RQ-VAE 码下移除并行预测头间的前缀嵌入条件（G1 w/o prefix conditioning），NDCG@10 下降 64–72%。"
        },
        {
          "id": "c1-flash-lsh-parallel",
          "record_id": null,
          "external_paper": "FLASH (arXiv:2610.07402v1)",
          "direction": "Unordered SimHash/LSH tokens align with parallel decoding (LSH > OPQ > RQ-VAE)",
          "grade": "Reported",
          "evidence": [
            "flash-lsh"
          ],
          "summary": "FLASH 3.2 节（#S3.SS2.p3.1）表明 SimHash 生成的无序独立码位天然适配并行解码，在固定并行解码主干下替换码本表现为 LSH > OPQ > RQ-VAE。"
        }
      ]
    },
    "trie-collisions": {
      "id": "trie-collisions",
      "title": "回答页：Trie 能消除出词表 ID，但不能消除同码碰撞",
      "decision_rules": [
        {
          "id": "rule-trie-not-resolver",
          "condition": "解码器挂前缀树（Trie）或合法前缀掩码约束",
          "claim": "Trie 只能保证生成的码序列落在目录合法前缀集合内（消除出词表 ID），不能区分落入同一叶节点的多个碰撞物品。",
          "grade": "Deduction",
          "evidence": [
            "hid-prefix"
          ],
          "boundary_note": "HiD-VAE 4.1 节明确说明 prefix tree 仅约束生成已知物品的合法 ID。"
        },
        {
          "id": "rule-change-code",
          "condition": "允许修改或重训分词器与码本分配策略",
          "claim": "优先在 Tokenization 阶段压低同码碰撞率：可采用分层监督与解耦均匀损失（HiD-VAE）、精确弹性匹配或重分配（PSI）、分布对齐正则（DIGER）或对比残差量化（CARD）。",
          "grade": "Reported",
          "evidence": [
            "hid-vae-design",
            "psi-design",
            "diger-design",
            "card-design"
          ],
          "boundary_note": "四篇工作均在各自协议下报告了碰撞率下降或下游检索指标提升，但评测协议不同，不可直接跨文混排数值。"
        },
        {
          "id": "rule-keep-code",
          "condition": "当碰撞率较低且工程上不重训分词器时",
          "claim": "保留现有碰撞码位，在解码器到达末层码桶后追加轻量桶内消歧头、候选重排器或 item-level 二次检索。",
          "grade": "Deduction",
          "evidence": [],
          "boundary_note": "该条为基于流水线接口的工程条件推断（Deduction），不绑定原文引文；注意 TIGER 原文 3.1 节追加额外位属于码本构造期的静态去重，而非推理期桶内消歧。"
        },
        {
          "id": "rule-poi-candidate",
          "condition": "面向地理敏感 POI 推荐且存在空间网格聚集与细粒度区分冲突",
          "claim": "将地理空间层次或软残差对比分配显式编码进 SID（如 GWhere），缓解高密度商圈内的前缀碰撞。",
          "grade": "Reported",
          "trigger": "any_poi_in_problem_II",
          "evidence": [
            "gwhere-design",
            "gwhere-tokenization"
          ],
          "boundary_note": "当 Problem II 有效记录集合包含 POI 领域论文时自动激活该条候选建议。"
        }
      ],
