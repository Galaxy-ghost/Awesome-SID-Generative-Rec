    "constraint-1": {
      "id": "constraint-1",
      "title": "码位依赖 ↔ 生成因子分解",
      "status": "Open",
      "status_source": {
        "baseline_doc": "SID-Survey/创新点查找.md#基线",
        "baseline_date": "2026-10-27",
        "adjudication_doc": "SID-Survey/AGENTS.md#已定的事",
        "adjudication_date": "2026-10-30",
        "summary": "固定码消融层（在固定分词器下移除前缀条件或改用并行解码）已有单侧实证（Reported）；但“码怎么分配决定码位条件互信息与并行可分解性”的跨阶段双向机制仍缺同一主干与协议下的 2×2 正交对照，总等级维持 Open。",
        "update_log": [
          {
            "date": "2026-10-27",
            "status": "Open",
            "authority": "leader",
            "note": "将牵制 1 定义为“码位依赖 ↔ 生成因子分解”，总证据等级定为 Open。"
          },
          {
            "date": "2026-10-30",
            "status": "Open",
            "authority": "leader",
            "note": "分层裁定：固定码消融这一层标 Reported（SID-MLP、FLASH、RPG 局部消融），“码怎么分配决定依赖”的跨阶段机制维持 Open。"
          }
        ]
      },
      "claim": "码位条件依赖（H(c_t | c_<t)）与生成解码因子分解（自回归链式、并行多头、迭代掩码去噪）相互牵制：残差层级码承载条件依赖时适配前缀条件分解，而正交/局部敏感哈希无序码适配并行独立输出头。",
      "why_open": "现有文献分别验证了固定 RQ 码下移除前缀条件的退化（SID-MLP）与固定并行解码器下切换 LSH/OPQ/RQ 的差异（FLASH、RPG），但尚无工作在同一主干、同一商品目录与切分协议下完成「可控码位互信息分词器 × 自回归/并行/掩码因子分解」的 2×2 正交对照实验。",
      "upgrade_requirement": "至少 1 组经独立复核的 2×2 正交对照实验（同一主干与评测协议下交叉改变码本依赖结构与生成因子分解），并提供可复核的原文元素与表格单元格锚点。",
      "upgrade_requirements_spec": {
        "required_design": "2x2_crossed_tokenization_x_factorization",
        "required_controls": [
          "fixed_backbone",
          "fixed_catalog_and_split",
          "crossed_tokenizer_dependency",
          "crossed_decoder_factorization"
        ]
      },
      "registered_crossed_controls": [],
      "observations": [
        {
          "id": "c1-ar-hierarchy",
