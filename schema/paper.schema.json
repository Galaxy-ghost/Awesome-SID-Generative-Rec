{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paper.schema.json",
  "title": "Paper record",
  "description": "One file per paper: data/papers/<id>.yaml. Field names are defined once here and checked against data/vocab.yaml by scripts/check.py.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "title",
    "authors",
    "year",
    "venue",
    "links",
    "problem",
    "stage",
    "representation",
    "tokenization",
    "backbone",
    "tokenizer",
    "objective",
    "inference",
    "poi",
    "tldr",
    "tldr_zh",
    "changes",
    "modality",
    "domain",
    "settings"
  ],
  "$defs": {
    "changeValue": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "primary",
            "none"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "quote",
            "where"
          ],
          "properties": {
            "value": {
              "type": "string",
              "const": "other"
            },
            "quote": {
              "type": "string",
              "minLength": 1
            },
            "where": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "modalityList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "properties": {
    "id": {
      "description": "Stable file key matching data/papers/<id>.yaml.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "description": "Method name as written in Table 1.",
      "type": "string",
      "minLength": 1
    },
    "title": {
      "description": "Full English paper title.",
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "description": "Author citation string as written in Table 1 (e.g. 'Rajput et al.').",
      "type": "string",
      "minLength": 1
    },
    "year": {
      "description": "Publication or preprint year.",
      "type": "integer",
      "minimum": 1990
    },
    "venue": {
      "description": "Venue string as written in Table 1 (e.g. 'NeurIPS’23', 'KDD’26 ADS', 'arXiv’26').",
      "type": "string",
      "minLength": 1
    },
    "links": {
      "description": "External links for the paper.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arxiv",
        "code"
      ],
      "properties": {
        "arxiv": {
          "description": "Paper URL (arXiv abs URL or DOI URL).",
          "type": "string",
          "minLength": 1
        },
        "code": {
          "description": "Code or project repository released by the paper's authors, or null.",
          "type": [
            "string",
            "null"
          ]
        },
        "code_third_party": {
          "description": "Third-party code repository URL, if no author implementation is available.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "problem": {
      "description": "Problem band in Table 1 ('psb' for top block, or 'I'–'VI'), checked against data/vocab.yaml.",
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "description": "Primary modified stage ('n/a' for psb, or 'Representation', 'Tokenization', 'Backbone', 'Training', 'Inference'), checked against data/vocab.yaml.",
      "type": "string",
      "minLength": 1
    },
    "representation": {
      "description": "Representation cell in Table 1 (verbatim, including † and A / B), checked against data/vocab.yaml.",
      "type": "string",
      "minLength": 1
    },
    "tokenization": {
      "description": "Tokenization cell in Table 1 (verbatim, including † and A / B), checked against data/vocab.yaml.",
      "type": "string",
      "minLength": 1
    },
    "backbone": {
      "description": "Backbone cell in Table 1 (verbatim, including † and A / B), checked against data/vocab.yaml.",
      "type": "string",
      "minLength": 1
    },
    "tokenizer": {
      "description": "Tokenizer training cell in Table 1 (verbatim, including † and A / B), checked against data/vocab.yaml.",
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "description": "Objective cell in Table 1 (verbatim, including † and A / B), checked against data/vocab.yaml.",
      "type": "string",
      "minLength": 1
    },
    "inference": {
      "description": "Inference cell in Table 1 (verbatim, including † and A / B), checked against data/vocab.yaml.",
      "type": "string",
      "minLength": 1
    },
    "poi": {
      "description": "Whether the paper targets POI / local-life / spatial recommendation.",
      "type": "boolean"
    },
    "evidence": {
      "description": "Optional list of locations in the paper, each with a verbatim quote, the curator's reason, or both.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "where"
        ],
        "anyOf": [
          {
            "required": [
              "quote"
            ]
          },
          {
            "required": [
              "reason"
            ]
          }
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1
          },
          "where": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "tldr": {
      "description": "One-sentence English summary stating the problem, core mechanism, and difference from prior work.",
      "type": "string",
      "minLength": 1
    },
    "tldr_zh": {
      "description": "One-sentence Chinese summary corresponding to tldr.",
      "type": "string",
      "minLength": 1
    },
    "setup": {
      "description": "Experimental setup card with seven fixed fields.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasets",
        "split",
        "candidates",
        "visibility",
        "sid",
        "inference_budget",
        "results_from"
      ],
      "properties": {
        "datasets": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "type": "string",
          "minLength": 1
        },
        "candidates": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "type": "string",
          "minLength": 1
        },
        "sid": {
          "type": "string",
          "minLength": 1
        },
        "inference_budget": {
          "type": "string",
          "minLength": 1
        },
        "results_from": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "setup_where": {
      "description": "Paper section/table/anchor locations for each setup field; only present alongside setup.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "datasets",
        "split",
        "candidates",
        "visibility",
        "sid",
        "inference_budget",
        "results_from"
      ],
      "properties": {
        "datasets": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "type": "string",
          "minLength": 1
        },
        "candidates": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "type": "string",
          "minLength": 1
        },
        "sid": {
          "type": "string",
          "minLength": 1
        },
        "inference_budget": {
          "type": "string",
          "minLength": 1
        },
        "results_from": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "related": {
      "description": "Manually verified relations to 1–5 other catalog papers.",
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "relation",
          "note",
          "where"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "enum": [
              "predecessor",
              "successor",
              "competitor",
              "alternative"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 1
          },
          "where": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "changes": {
      "description": "Per-column change markers across the six Table 1 technical columns ('primary', 'none', or {value: 'other', quote, where}).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "representation",
        "tokenization",
        "backbone",
        "tokenizer",
        "objective",
        "inference"
      ],
      "properties": {
        "representation": {
          "$ref": "#/$defs/changeValue"
        },
        "tokenization": {
          "$ref": "#/$defs/changeValue"
        },
        "backbone": {
          "$ref": "#/$defs/changeValue"
        },
        "tokenizer": {
          "$ref": "#/$defs/changeValue"
        },
        "objective": {
          "$ref": "#/$defs/changeValue"
        },
        "inference": {
          "$ref": "#/$defs/changeValue"
        }
      }
    },
    "modality": {
      "description": "SID tokenizer input modalities as a list of vocabulary values or a branch-name-to-list mapping.",
      "oneOf": [
        {
          "$ref": "#/$defs/modalityList"
        },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "modality_open": {
      "description": "Optional list of open/unverified tokenizer input signals when modality includes 'Other'.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "modality_other": {
      "description": "Required when modality includes 'Other': what the tokenizer actually reads, one entry per branch that uses 'Other' ('branch' names the branch when modality is a mapping).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "en",
          "zh",
          "quote",
          "where"
        ],
        "properties": {
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "en": {
            "type": "string",
            "minLength": 1
          },
          "zh": {
            "type": "string",
            "minLength": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "where": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "modality_where": {
      "description": "Optional quote and location when modality is re-verified from the paper.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quote",
        "where"
      ],
      "properties": {
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "where": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "note": {
      "description": "Optional curator note explaining modality or annotation details.",
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "description": "Application domain(s) evaluated in the paper, checked against data/vocab.yaml.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "domain_other": {
      "description": "Required when domain includes 'Other': the business the paper's data comes from, as the paper states it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "zh",
        "quote",
        "where"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1
        },
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        },
        "where": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "settings": {
      "description": "Special experimental evaluation settings ('cold-start' with required 'scope' in ['user', 'item'], 'cross-domain', 'catalog-change').",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "value",
          "quote",
          "where"
        ],
        "properties": {
          "value": {
            "type": "string",
            "enum": [
              "cold-start",
              "cross-domain",
              "catalog-change"
            ]
          },
          "scope": {
            "type": "string",
            "enum": [
              "user",
              "item"
            ]
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "where": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "featured": {
      "description": "Optional. true shows this paper first in its cell of the README taxonomy figure.",
      "type": "boolean"
    }
  },
  "dependentRequired": {
    "setup_where": [
      "setup"
    ]
  }
}
