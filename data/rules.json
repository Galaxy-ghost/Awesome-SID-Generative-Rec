  "decision_rules": [
    {
      "id": "rule-trie-not-resolver",
      "condition": "解码器挂前缀树（Trie）或合法前缀掩码约束",
      "claim": "Trie 只能保证生成的码序列落在目录合法前缀集合内（消除出词表 ID），不能区分落入同一叶节点的多个碰撞物品。",
      "grade": "Deduction",
      "evidence": [
        "hid-prefix"
      ],
      "boundary_note": "HiD-VAE 4.1 节明确说明 prefix tree 仅约束生成已知物品的合法 ID。"
    },
    {
      "id": "rule-change-code",
      "condition": "允许修改或重训分词器与码本分配策略",
      "claim": "优先在 Tokenization 阶段压低同码碰撞率：可采用分层监督与解耦均匀损失（HiD-VAE）、精确弹性匹配或重分配（PSI）、分布对齐正则（DIGER）或对比残差量化（CARD）。",
      "grade": "Reported",
      "evidence": [
        "hid-vae-design",
        "psi-design",
        "diger-design",
        "card-design"
      ],
      "boundary_note": "四篇工作均在各自协议下报告了碰撞率下降或下游检索指标提升，但评测协议不同，不可直接跨文混排数值。"
    },
    {
      "id": "rule-keep-code",
      "condition": "当碰撞率较低且工程上不重训分词器时",
      "claim": "保留现有碰撞码位，在解码器到达末层码桶后追加轻量桶内消歧头、候选重排器或 item-level 二次检索。",
      "grade": "Deduction",
      "evidence": [],
      "boundary_note": "该条为基于流水线接口的工程条件推断（Deduction），不绑定原文引文；注意 TIGER 原文 3.1 节追加额外位属于码本构造期的静态去重，而非推理期桶内消歧。"
    },
    {
      "id": "rule-poi-candidate",
      "condition": "面向地理敏感 POI 推荐且存在空间网格聚集与细粒度区分冲突",
      "claim": "将地理空间层次或软残差对比分配显式编码进 SID（如 GWhere），缓解高密度商圈内的前缀碰撞。",
      "grade": "Reported",
      "trigger": "any_poi_in_problem_II",
      "evidence": [
        "gwhere-design",
        "gwhere-tokenization"
      ],
      "boundary_note": "当 Problem II 有效记录集合包含 POI 领域论文时自动激活该条候选建议。"
    }
  ]
}
